# Shared
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/post_purchase_revenue_engine?schema=public"
APP_URL="https://your-app-domain.com"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
NODE_ENV="development"

# Shopify app
SHOPIFY_API_KEY="replace_me"
SHOPIFY_API_SECRET="replace_me"
SHOPIFY_APP_SCOPES="read_products,read_orders,write_discounts,read_discounts,read_customers"
SHOPIFY_API_VERSION="2026-04"

# Frontend
NEXT_PUBLIC_SHOPIFY_API_KEY="replace_me"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Local demo fallback
DEMO_MODE="true"
ALLOW_UNAUTHENTICATED_ADMIN="true"
