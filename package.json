{
  "name": "perfect-plants-sku",
  "version": "0.1.0",
  "private": true,
  "description": "Perfect Plants SKU storefront and Shopify post-purchase revenue engine.",
  "workspaces": [
    "frontend",
    "backend",
    "extensions/post-purchase-offer"
  ],
  "overrides": {
    "next": {
      "postcss": "8.5.15"
    },
    "postcss": "8.5.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm:dev --workspace frontend\" \"npm:dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run prisma:generate && npm run build --workspace backend && npm run build --workspace frontend && npm run build --workspace @ppre/checkout-extension",
    "typecheck": "npm run prisma:generate && npm run typecheck --workspace backend && npm run typecheck --workspace frontend && npm run typecheck --workspace @ppre/checkout-extension",
    "lint": "npm run lint --workspace frontend",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "6.19.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
